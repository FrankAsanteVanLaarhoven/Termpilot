FROM python:3.12-slim
WORKDIR /opt/termpilot
COPY backend /opt/termpilot/backend
COPY fixtures /opt/termpilot/fixtures
WORKDIR /opt/termpilot/backend
RUN pip install --no-cache-dir .
ENV FIXTURES_ROOT=/opt/termpilot/fixtures
ENV TERMPILOT_ENV=demo
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
