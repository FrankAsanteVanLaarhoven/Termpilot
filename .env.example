# TermPilot environment
# Copy to .env and fill secrets locally. Never commit real keys.

# Runtime
TERMPILOT_ENV=demo
TERMPILOT_HOST=127.0.0.1
TERMPILOT_PORT=8000
TERMPILOT_FRONTEND_ORIGIN=http://127.0.0.1:3000
# Comma-separated extra browser origins. Vercel preview URLs are allowed by regex.
TERMPILOT_CORS_ORIGINS=
TERMPILOT_TIMEZONE=Europe/London
# Frozen competition clock. Leave empty to use wall clock.
TERMPILOT_NOW=2026-09-05T08:00:00+01:00
TERMPILOT_DEMO_USER_ID=FAVL
# Optional classroom gate for live student deploys. Leave empty to skip the extra code.
TERMPILOT_ACCESS_CODE=
# Extra campus mail domains (comma-separated) that are not .edu / .ac.* / .edu.*.
TERMPILOT_UNIVERSITY_DOMAINS=

# Auth: hashed passwords, httpOnly cookies, email/SMS one-time codes.
# Never commit real keys. Production login requires verified campus email + 2FA.
# Resend sends FROM student@termpilot.org (mailbox aliases live on hello@).
RESEND_API_KEY=
SMTP_URL=
TERMPILOT_AUTH_FROM=TermPilot <student@termpilot.org>
TERMPILOT_REPLY_TO=support@termpilot.org
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TERMPILOT_SESSION_DAYS=7

# Database — SQLite for local demo, PostgreSQL/Neon for production
DATABASE_URL=sqlite+aiosqlite:///./termpilot.db

# Grok / xAI. If unset, TermPilot uses the deterministic FakeGrokAdapter.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
GROK_MODE=auto
# auto | fake | live

# Planning
PLAN_HORIZON_DAYS=14
MAX_STUDY_BLOCK_MINUTES=120
BREAK_MINUTES=15
SAFETY_BUFFER_HOURS=24
WEEKLY_STUDY_LIMIT_HOURS=20

# Privacy
RAW_SOURCE_RETENTION_HOURS=72
APPROVAL_TTL_MINUTES=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Failure injection (demo / tests only)
SIMULATE_LMS_OUTAGE=false
SIMULATE_GROK_TIMEOUT=false
SIMULATE_CALENDAR_WRITE_FAILURE=false
SIMULATE_OFFLINE=false

# Optional live OAuth. One-click Connect always works with fixture adapters
# even when these are empty. Set a client id to offer live sign-in as well.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
